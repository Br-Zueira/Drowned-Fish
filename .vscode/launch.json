{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lua-local",
            "request": "launch",
            "name": "Debug LÖVE",
            "program": {
                "command": "love"
            },
            "args": [
                "${workspaceFolder}",
                "--sector=${input:sector}",
                "--level=${input:level}"
            ],
            "windows": {
                "program": {
                    "command": "C:/Program Files/LOVE/love.exe"
                }
            },
            "osx": {
                "program": {
                    "command": "/Applications/love.app/Contents/MacOS/love"
                }
            },
            "linux": {
                "program": {
                    "command": "love"
                }
            }
        }
    ],
    "inputs": [
        {
            "id": "sector",
            "type": "promptString",
            "description": "Enter sector to test",
            "default": "Special"
        },
        {
            "id": "level",
            "type": "promptString",
            "description": "Enter level to test",
            "default": "Hub"
        }
    ]
}